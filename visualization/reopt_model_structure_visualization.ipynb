+{
+  "cells": [
+    {
+      "cell_type": "markdown",
+      "metadata": {},
+      "source": [
+        "# REopt model structure visualization\n",
+        "This notebook explores the REopt optimization model using three conceptual layers (Input, Model, Output) and edge domains (Energy=red, Data=blue, Money=green)."
+      ]
+    },
+    {
+      "cell_type": "code",
+      "metadata": {},
+      "source": [
+        "import json\n",
+        "import networkx as nx\n",
+        "import pandas as pd\n",
+        "from pathlib import Path\n",
+        "from pyvis.network import Network\n",
+        "import ipywidgets as widgets\n",
+        "\n",
+        "graph_data = json.loads(Path('reopt_model_graph.json').read_text())\n",
+        "graph_data['nodes'][:2], graph_data['edges'][:2]"
+      ],
+      "execution_count": null,
+      "outputs": []
+    },
+    {
+      "cell_type": "code",
+      "metadata": {},
+      "source": [
+        "G = nx.DiGraph()\n",
+        "for n in graph_data['nodes']:\n",
+        "    G.add_node(n['id'], **n)\n",
+        "for e in graph_data['edges']:\n",
+        "    G.add_edge(e['source'], e['target'], **e)\n",
+        "len(G), G.number_of_edges()"
+      ],
+      "execution_count": null,
+      "outputs": []
+    },
+    {
+      "cell_type": "code",
+      "metadata": {},
+      "source": [
+        "import collections\n",
+        "type_counts = collections.Counter(nx.get_node_attributes(G, 'type').values())\n",
+        "layer_counts = collections.Counter(nx.get_node_attributes(G, 'layer').values())\n",
+        "pd.DataFrame({'type': list(type_counts.keys()), 'count': list(type_counts.values())})\n",
+        "pd.DataFrame({'layer': list(layer_counts.keys()), 'count': list(layer_counts.values())})"
+      ],
+      "execution_count": null,
+      "outputs": []
+    },
+    {
+      "cell_type": "code",
+      "metadata": {},
+      "source": [
+        "deg = nx.degree_centrality(G)\n",
+        "top_deg = sorted(deg.items(), key=lambda x: x[1], reverse=True)[:10]\n",
+        "pd.DataFrame(top_deg, columns=['node', 'degree_centrality'])"
+      ],
+      "execution_count": null,
+      "outputs": []
+    },
+    {
+      "cell_type": "code",
+      "metadata": {},
+      "source": [
+        "# Interactive visualization with pyvis\n",
+        "net = Network(height='600px', width='100%', directed=True)\n",
+        "color_by_layer = {'input':'#cce5ff','model':'#f0f0f0','output':'#d4edda'}\n",
+        "edge_color = {'energy':'red','data':'blue','money':'green'}\n",
+        "for node, data in G.nodes(data=True):\n",
+        "    net.add_node(node, label=data.get('label', node), title=str(data), color=color_by_layer.get(data.get('layer'),'#ddd'))\n",
+        "for u,v,data in G.edges(data=True):\n",
+        "    net.add_edge(u, v, title=data.get('relation',''), color=edge_color.get(data.get('domain'),'gray'))\n",
+        "net.show('pyvis_reopt_graph.html')\n",
+        "from IPython.display import IFrame\n",
+        "IFrame('pyvis_reopt_graph.html', width='100%', height='650px')"
+      ],
+      "execution_count": null,
+      "outputs": []
+    },
+    {
+      "cell_type": "code",
+      "metadata": {},
+      "source": [
+        "# Filtering widgets\n",
+        "layer_options = ['input','model','output']\n",
+        "domain_options = ['energy','data','money']\n",
+        "layer_select = widgets.SelectMultiple(options=layer_options, value=tuple(layer_options), description='Layers')\n",
+        "domain_select = widgets.SelectMultiple(options=domain_options, value=tuple(domain_options), description='Domains')\n",
+        "display(layer_select, domain_select)\n",
+        "\n",
+        "def filtered_net(layers, domains):\n",
+        "    sub = G.copy()\n",
+        "    for n in list(sub.nodes()):\n",
+        "        if sub.nodes[n].get('layer') not in layers:\n",
+        "            sub.remove_node(n)\n",
+        "    for u,v,data in list(sub.edges(data=True)):\n",
+        "        if data.get('domain') not in domains:\n",
+        "            sub.remove_edge(u,v)\n",
+        "    net = Network(height='600px', width='100%', directed=True)\n",
+        "    for node, data in sub.nodes(data=True):\n",
+        "        net.add_node(node, label=data.get('label', node), title=str(data), color=color_by_layer.get(data.get('layer'),'#ddd'))\n",
+        "    for u,v,data in sub.edges(data=True):\n",
+        "        net.add_edge(u,v, title=data.get('relation',''), color=edge_color.get(data.get('domain'),'gray'))\n",
+        "    net.show('pyvis_reopt_graph_filtered.html')\n",
+        "    return IFrame('pyvis_reopt_graph_filtered.html', width='100%', height='650px')\n",
+        "\n",
+        "widgets.interact(filtered_net, layers=layer_select, domains=domain_select);"
+      ],
+      "execution_count": null,
+      "outputs": []
+    }
+  ],
